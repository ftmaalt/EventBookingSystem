<?xml version="1.0" encoding="UTF-8"?>
<!--
  Aggregator only: builds every microservice with one command (used by CI).
      ./mvnw verify
  Each service is still independent (own parent, dependencies and version) and can be built on its own
  from its folder. The old monolith tests under src/test are kept for reconfiguring and are not built here.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.bookngo</groupId>
	<artifactId>bookngo</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>bookngo</name>
	<description>BookNGo microservices</description>

	<modules>
		<module>auth-service</module>
		<module>catalog-service</module>
		<module>booking-service</module>
		<module>notification-service</module>
		<module>compliance-service</module>
	</modules>
</project>
